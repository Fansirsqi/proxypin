From 2efe778af0cd174fef5cb648251e10cfd7d527fd Mon Sep 17 00:00:00 2001
From: BysevenOffical <38542005+Fansirsqi@users.noreply.github.com>
Date: Mon, 9 Nov 2026 17:50:57 +0800
Subject: [PATCH 1/3] fix(linux): install the root CA through polkit with
 distro-aware trust stores

The Linux branch copied the CA to /usr/local/share/ca-certificates and ran
update-ca-certificates as the unprivileged user, so it always failed silently
(the exception was swallowed and the UI only reported "installation failed").
On Arch/Fedora that command does not exist at all -- p11-kit is used instead --
and the directory is missing too.

Detect the trust store per distribution (Debian style
/usr/local/share/ca-certificates + update-ca-certificates, or p11-kit
/etc/ca-certificates/trust-source/anchors + trust extract-compat) and install and
refresh in a single `pkexec sh -c ...` call, so polkit prompts once.

Also drop the certificate into the NSS user database (~/.pki/nssdb) when present:
Chrome/Chromium on Linux ignore the system store, so HTTPS capture kept failing
there. The anchor is written as proxypin-ca.crt to avoid clobbering an unrelated
ca.crt, and isCertInstalled() now checks all supported locations.

Verified on Arch (p11-kit path): the certificate lands in the anchors directory,
`trust extract-compat` runs after authorisation and Chrome picks it up.
---
 lib/ui/desktop/ssl/cert_installer.dart | 133 +++++++++++++++++++++----
 lib/ui/desktop/ssl/pc_cert.dart        |  35 ++++---
 2 files changed, 134 insertions(+), 34 deletions(-)

diff --git a/lib/ui/desktop/ssl/cert_installer.dart b/lib/ui/desktop/ssl/cert_installer.dart
index 2264fb4..b3f494f 100644
--- a/lib/ui/desktop/ssl/cert_installer.dart
+++ b/lib/ui/desktop/ssl/cert_installer.dart
@@ -32,15 +32,7 @@ class CertInstaller {
       }
 
       if (Platform.isLinux) {
-        // Linux: 拷贝到 /usr/local/share/ca-certificates/ 并更新证书
-        final certName = certFile.uri.pathSegments.last.endsWith('.crt')
-            ? certFile.uri.pathSegments.last
-            : '${certFile.uri.pathSegments.last}.crt';
-        final destPath = '/usr/local/share/ca-certificates/$certName';
-        await certFile.copy(destPath);
-        final result = await Process.run('update-ca-certificates', []);
-        logger.d('update-ca-certificates result: \\${result.stdout} \\${result.stderr}');
-        return result.exitCode == 0;
+        return await installLinuxCertificate(certFile);
       }
 
       // 其他平台暂不支持
@@ -51,6 +43,115 @@ class CertInstaller {
     }
   }
 
+  /// 安装到系统库时使用的固定文件名，避免和用户其它 ca.crt 撞名
+  static const String _anchorFileName = 'proxypin-ca.crt';
+  static const String _debianAnchorDir = '/usr/local/share/ca-certificates';
+  static const String _p11kitAnchorDir = '/etc/ca-certificates/trust-source/anchors';
+  static const String _fedoraAnchorDir = '/etc/pki/ca-trust/source/anchors';
+
+  static String _certFileName(File certFile) {
+    final name = certFile.uri.pathSegments.last;
+    return name.endsWith('.crt') ? name : '$name.crt';
+  }
+
+  /// Linux 没有统一的根证书库：
+  ///  - Fedora/RHEL/openSUSE(Tumbleweed): /etc/pki/ca-trust/source/anchors + update-ca-trust
+  ///  - Debian/Ubuntu: /usr/local/share/ca-certificates + update-ca-certificates
+  ///  - Arch:          p11-kit 的 trust anchor + trust extract-compat
+  /// 都需要 root，所以用 pkexec 触发 polkit 图形提权（只弹一次密码框）。
+  static Future<bool> installLinuxCertificate(File certFile) async {
+    String? anchorDir;
+    List<String> refresh;
+    if (File('/usr/bin/update-ca-trust').existsSync() && Directory(_fedoraAnchorDir).existsSync()) {
+      anchorDir = _fedoraAnchorDir;
+      refresh = ['update-ca-trust', 'extract'];
+    } else if (File('/usr/bin/update-ca-certificates').existsSync()) {
+      anchorDir = _debianAnchorDir;
+      refresh = ['update-ca-certificates'];
+    } else if (File('/usr/bin/trust').existsSync()) {
+      anchorDir = _p11kitAnchorDir;
+      refresh = ['trust', 'extract-compat'];
+    } else {
+      logger.w('No supported CA store found, please install ca-certificates-utils / ca-certificates');
+      return false;
+    }
+
+    if (!Directory(anchorDir).existsSync()) {
+      logger.w('CA anchor directory $anchorDir does not exist');
+      return false;
+    }
+
+    final target = '$anchorDir/$_anchorFileName';
+    final uid = (await Process.run('id', ['-u'])).stdout.toString().trim();
+    bool success;
+
+    if (uid == '0') {
+      // 已经以 root 运行（例如自己 sudo 启动），直接装
+      await certFile.copy(target);
+      final result = await Process.run(refresh.first, refresh.sublist(1));
+      logger.d('${refresh.first} result: ${result.stdout} ${result.stderr}');
+      success = result.exitCode == 0;
+    } else {
+      // 一条 shell 里完成“拷贝 + 刷新”，避免弹两次密码框
+      final refreshCommand = refresh.map((e) => "'$e'").join(' ');
+      final script = 'install -Dm644 "\$1" "\$2" && $refreshCommand';
+      try {
+        final result = await Process.run('pkexec', ['sh', '-c', script, 'sh', certFile.path, target]);
+        logger.d('pkexec install certificate (${result.exitCode}): ${result.stdout} ${result.stderr}');
+        success = result.exitCode == 0;
+        if (!success && (result.exitCode == 126 || result.exitCode == 127)) {
+          logger.w('pkexec authorization failed (no polkit agent?), fall back to manual install');
+        }
+      } on ProcessException catch (e) {
+        logger.e('pkexec not available: $e');
+        success = false;
+      }
+    }
+
+    if (success) {
+      await installToNssDatabase(certFile);
+    }
+    return success;
+  }
+
+  /// Chrome/Chromium 在 Linux 上读的是 NSS 用户库（~/.pki/nssdb）而不是系统根证书库，
+  /// 顺手装一份（这是用户级操作，不需要提权）。
+  static Future<void> installToNssDatabase(File certFile) async {
+    try {
+      final home = Platform.environment['HOME'];
+      if (home == null || !Directory('$home/.pki/nssdb').existsSync()) {
+        return;
+      }
+
+      final result = await Process.run('certutil', [
+        '-d',
+        'sql:$home/.pki/nssdb',
+        '-A',
+        '-t',
+        'C,,',
+        '-n',
+        'ProxyPin CA',
+        '-i',
+        certFile.path,
+      ]);
+      logger.d('certutil -A result: ${result.stdout} ${result.stderr}');
+    } catch (e) {
+      logger.w('Install certificate to NSS database skipped: $e');
+    }
+  }
+
+  static bool _isLinuxCertInstalled(File certFile) {
+    final legacyName = _certFileName(certFile);
+    final names = {_anchorFileName, legacyName};
+    const dirs = [
+      _p11kitAnchorDir,
+      '/etc/pki/trust/anchors', // openSUSE
+      _debianAnchorDir,
+      '/etc/ssl/certs',
+    ];
+    return dirs.any((dir) => names.any((name) => File('$dir/$name').existsSync()));
+  }
+
   /// 检查证书是否已安装
   static Future<bool> isCertInstalled(File filePath, X509CertificateData caCert) async {
     String commonName = caCert.subject['2.5.4.3'] ?? 'ProxyPin CA';
@@ -76,19 +177,7 @@ class CertInstaller {
         }
         return false;
       } else if (Platform.isLinux) {
-        // 只检查 /usr/local/share/ca-certificates/ 下是否有对应证书文件
-        final certName = filePath.uri.pathSegments.last.endsWith('.crt')
-            ? filePath.uri.pathSegments.last
-            : '${filePath.uri.pathSegments.last}.crt';
-
-        var paths = [
-          '/usr/local/share/ca-certificates/$certName',
-          '/etc/ssl/certs/$certName',
-        ];
-        for (var p in paths) {
-          if (await File(p).exists()) return true;
-        }
-        return false;
+        return _isLinuxCertInstalled(filePath);
       }
     } catch (_) {}
     return false;
