From 6909c97e1037c2842f8195f9ee1f1896b95e98bb Mon Sep 17 00:00:00 2001
From: BysevenOffical <38542005+Fansirsqi@users.noreply.github.com>
Date: Mon, 9 Nov 2026 17:06:44 +0800
Subject: [PATCH] fix(linux): build with current toolchains (appindicator
 warnings, FFI symbols, icon path)

Three separate breakages on rolling-release toolchains (Arch/CachyOS, clang 19+,
gcc 15+, libayatana-appindicator 0.6, Flutter 3.44+):

1. tray_manager's Linux plugin still calls the deprecated app_indicator_* API and
   is compiled with -Werror, so the build aborts as soon as the deprecation is
   reported. Build the plugins without -Werror for deprecated declarations only.

2. libcode_forge.so (flutter_rust_bridge / cargokit) cannot resolve
   Dart_CurrentIsolate_DL and friends at runtime, because current engines no
   longer export Dart_* from libflutter_linux_gtk.so. Compile the Dart SDK's
   dart_api_dl.c into the runner and export the dynamic symbol table; CMake picks
   the file up from the Flutter SDK in use (override with
   PROXYPIN_DART_API_DL_C).

3. The release window icon is hardcoded to /opt/proxypin (the Debian layout), so
   any other install prefix shows a GTK warning and no icon. Resolve it relative
   to /proc/self/exe instead.

Verified on Arch/CachyOS with Flutter 3.47.9 + clang 23: `flutter build linux
--release` succeeds, the resulting binary exports 45 Dart_* symbols and the
runtime no longer logs "RustLib.init failed".
---
 linux/CMakeLists.txt    | 35 +++++++++++++++++++++++++++++++++++
 linux/my_application.cc | 14 +++++++++++++-
 2 files changed, 48 insertions(+), 1 deletion(-)

diff --git a/linux/CMakeLists.txt b/linux/CMakeLists.txt
index 1739998..8cd685c 100644
--- a/linux/CMakeLists.txt
+++ b/linux/CMakeLists.txt
@@ -13,6 +13,11 @@ set(APPLICATION_ID "com.network.proxy")
 # versions of CMake.
 cmake_policy(SET CMP0063 NEW)
 
+# Newer libayatana-appindicator (Arch / clang 19+ / gcc 15+ toolchains) marks the
+# legacy app_indicator_* API as deprecated; the bundled tray_manager plugin still
+# uses it, so do not let -Werror abort the build there.
+add_compile_options(-Wno-error=deprecated-declarations)
+
 # Load bundled libraries from the lib/ directory relative to the binary.
 set(CMAKE_INSTALL_RPATH "$ORIGIN/lib")
 
@@ -56,6 +61,30 @@ pkg_check_modules(GTK REQUIRED IMPORTED_TARGET gtk+-3.0)
 
 add_definitions(-DAPPLICATION_ID="${APPLICATION_ID}")
 
+# Dart API dynamic-lookup symbols for FFI plugins (code_forge / flutter_rust_bridge).
+# Current Flutter engines no longer export Dart_* from libflutter_linux_gtk.so, so
+# plugins such as libcode_forge.so cannot resolve Dart_InitializeApiDL and are
+# silently disabled unless the host executable provides those symbols. Compile
+# dart_api_dl.c from the Dart SDK into the app and export the dynamic symbol table.
+set(DART_API_DL_SOURCE "")
+if(NOT "$ENV{PROXYPIN_DART_API_DL_C}" STREQUAL "")
+  set(DART_API_DL_SOURCE "$ENV{PROXYPIN_DART_API_DL_C}")
+else()
+  find_program(_FLUTTER_EXECUTABLE NAMES flutter)
+  if(_FLUTTER_EXECUTABLE)
+    get_filename_component(_FLUTTER_BIN_DIR "${_FLUTTER_EXECUTABLE}" PATH)
+    get_filename_component(_FLUTTER_SDK_DIR "${_FLUTTER_BIN_DIR}" PATH)
+    set(DART_API_DL_SOURCE "${_FLUTTER_SDK_DIR}/bin/cache/dart-sdk/include/dart_api_dl.c")
+  endif()
+endif()
+if(EXISTS "${DART_API_DL_SOURCE}")
+  enable_language(C)
+  set_source_files_properties("${DART_API_DL_SOURCE}" PROPERTIES COMPILE_OPTIONS "-Wno-error")
+else()
+  message(WARNING "dart_api_dl.c not found: FFI plugins (code_forge) may fail to load")
+  set(DART_API_DL_SOURCE "")
+endif()
+
 # Define the application target. To change its name, change BINARY_NAME above,
 # not the value here, or `flutter run` will no longer work.
 #
@@ -64,12 +93,18 @@ add_executable(${BINARY_NAME}
   "main.cc"
   "my_application.cc"
   "${FLUTTER_MANAGED_DIR}/generated_plugin_registrant.cc"
+  ${DART_API_DL_SOURCE}
 )
 
 # Apply the standard set of build settings. This can be removed for applications
 # that need different build settings.
 apply_standard_settings(${BINARY_NAME})
 
+# Export the Dart API DL symbols compiled above so FFI plugins can resolve them.
+if(DART_API_DL_SOURCE)
+  set_property(TARGET ${BINARY_NAME} APPEND_STRING PROPERTY LINK_FLAGS " -Wl,--export-dynamic")
+endif()
+
 # Add dependency libraries. Add any application-specific dependencies here.
 target_link_libraries(${BINARY_NAME} PRIVATE flutter)
 target_link_libraries(${BINARY_NAME} PRIVATE PkgConfig::GTK)
diff --git a/linux/my_application.cc b/linux/my_application.cc
index 4fd669e..54b5fbf 100644
--- a/linux/my_application.cc
+++ b/linux/my_application.cc
@@ -55,7 +55,19 @@ static void my_application_activate(GApplication* application) {
   if (g_file_test("assets", G_FILE_TEST_IS_DIR)) {
       gtk_window_set_icon_from_file(window, "assets/icon.png", NULL); // For debug mode
   } else {
-      gtk_window_set_icon_from_file(window, "/opt/proxypin/data/flutter_assets/assets/icon.png", NULL); // For release mode
+      // Resolve the icon relative to the release bundle instead of hardcoding a
+      // Debian-specific install path, so any prefix (/usr/lib/proxypin, /opt/...)
+      // works.
+      g_autofree gchar* exe_path = g_file_read_link("/proc/self/exe", NULL);
+      g_autofree gchar* exe_dir =
+          exe_path != NULL ? g_path_get_dirname(exe_path) : NULL;
+      g_autofree gchar* icon_path =
+          exe_dir != NULL
+              ? g_build_filename(exe_dir, "data", "flutter_assets", "assets",
+                                 "icon.png", NULL)
+              : NULL;
+      gtk_window_set_icon_from_file(
+          window, icon_path != NULL ? icon_path : "assets/icon.png", NULL);
   }
 
   g_autoptr(FlDartProject) project = fl_dart_project_new();
-- 
2.56.0

